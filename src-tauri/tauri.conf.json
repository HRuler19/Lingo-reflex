{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LexiPulse",
  "version": "1.2.0",
  "identifier": "com.lexipulse.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "LexiPulse",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage"],
    "category": "Education",
    "shortDescription": "Time-pressured vocabulary and phrase trainer",
    "longDescription": "LexiPulse is a local-first vocabulary and phrase trainer that pairs active recall with time-pressured typing practice. No account, no backend, no network.",
    "copyright": "Copyright © 2026 Hangeldi Cholukov",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
